// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}




model Account {
  id                 String  @id @default(cuid()) @map("_id")
  userId             String 
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String   
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid()) @map("_id") 
  name          String?
  email         String   @unique
  password      String?   // Make this field optional
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  Post          Post[]
  articles      Article[]
  comments      Comment[] 
  isAdmin       Boolean  @default(false) 

}

model VerificationToken {
  identifier String @id @map("_id")
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}


model Category { 
  id String @id @default(cuid()) @map("_id")
  slug String @unique 
  title String
  img String?
  Posts Post[]
}
model Post {
  id        String    @id @default(cuid()) @map("_id")
  createdAt DateTime  @default(now())
  slug      String    @unique
  title     String
  desc      String
  img       String?
  views     Int       @default(0)
  catSlug   String
  cat       Category  @relation(fields: [catSlug], references: [slug]) 
  userEmail String
  user      User      @relation(fields: [userEmail], references: [email]) 
  authorId   String
  authorName String 

  // Additional fields...
}


model Topic { 
  id          String   @id @default(cuid()) @map("_id") 
  title       String   @unique
  description String?
  article     TopicArticle[]
}

model Article { 
  id          String   @id @default(cuid()) @map("_id") 
  title       String
  description String?
  date        DateTime @default(now())
  content     String?
  topic       String
  author      String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contents    Content[]
  guid        String?  @unique 
  link        String?  // Link to the original article
  isRssPost   Boolean  @default(false) // Flag to identify RSS feed articles
  img         String?  // Image URL for the article
  filtered_images String? //
  Topic       TopicArticle[]
}


model TopicArticle{ 
  id        String   @id @default(cuid()) @map("_id") 
  topicId   String
  articleId String
  topic     Topic    @relation(fields: [topicId], references: [id])
  article    Article   @relation(fields: [articleId], references: [id])

  @@unique([topicId, articleId])
}

model Content { 
  id        String   @id @default(cuid()) @map("_id") 
  heading   String?  // Optional heading
  paragraphs String[] // Array of paragraphs
  articleId String    @map("_articleId") 
  article   Article   @relation(fields: [articleId], references: [id])
}

model Subscriber {
  id        String   @id @default(cuid()) @map("_id") 
  email     String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model LinkedinAuth {
  id            String   @id @default(cuid()) @map("_id") 
  organizationId String  @unique
  accessToken   String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Comment {
  id String @id @default(cuid()) @map("_id")
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userEmail String
  user User @relation(fields: [userEmail], references: [email])
  postSlug String?
}

